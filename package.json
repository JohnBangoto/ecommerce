{
  "name": "ecommerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:frontend:docker": "vite --mode docker",
    "dev:backend": "npm --prefix backend run dev",
    "dev:local": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\" --names front,back --prefix name",
    "dev": "npm run dev:local",
    "dev:db": "docker compose up -d db",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs:backend": "docker compose logs -f backend",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "concurrently": "^8.2.0"
  }
}
